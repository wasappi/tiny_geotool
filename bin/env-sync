#!/usr/bin/env bash
# Write the local .env from the Bitwarden item "geotool-dev".
# Usage: bin/env-sync            (item name can be overridden with BW_ITEM)
set -euo pipefail

ITEM="${BW_ITEM:-geotool-dev}"
ENV_FILE="$(cd "$(dirname "$0")/.." && pwd)/.env"
DATABASE_URL="postgresql+psycopg://geotool:geotool@localhost:5433/geotool"  # docker compose db

for cmd in bw jq; do
  command -v "$cmd" >/dev/null || { echo "error: $cmd is not installed" >&2; exit 1; }
done

case "$(bw status | jq -r .status)" in
  unauthenticated) echo "error: run 'bw login' first" >&2; exit 1 ;;
  locked) BW_SESSION="$(bw unlock --raw)"; export BW_SESSION ;;
esac

bw sync >/dev/null
item="$(bw get item "$ITEM")"

field() {
  jq -er --arg name "$1" '.fields[]? | select(.name == $name) | .value' <<<"$item" \
    || { echo "error: field $1 missing in Bitwarden item $ITEM" >&2; return 1; }
}

MAPBOX_PUBLIC_TOKEN="$(field MAPBOX_PUBLIC_TOKEN)"
ADMIN_TOKEN="$(field ADMIN_TOKEN)"

umask 077
tmp="$(mktemp "$ENV_FILE.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
{
  echo "# Generated by bin/env-sync from Bitwarden item $ITEM. Do not edit; edit the vault and re-run."
  printf "DATABASE_URL='%s'\n" "$DATABASE_URL"
  printf "MAPBOX_PUBLIC_TOKEN='%s'\n" "$MAPBOX_PUBLIC_TOKEN"
  printf "ADMIN_TOKEN='%s'\n" "$ADMIN_TOKEN"
} >"$tmp"
mv "$tmp" "$ENV_FILE"
trap - EXIT
echo "wrote $ENV_FILE"
