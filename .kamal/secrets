# Production secrets, fetched from Bitwarden at deploy time.
# This file holds no values and is safe to commit.
#
# Bitwarden item "geotool-prod" needs these custom fields:
#   MAPBOX_PUBLIC_TOKEN, ADMIN_TOKEN, POSTGRES_PASSWORD
#
# Requires: bw (logged in or BW_ACCOUNT set to your Bitwarden email),
#           gh logged in with the write:packages scope (registry push).

SECRETS=$(kamal secrets fetch --adapter bitwarden --account $BW_ACCOUNT --from geotool-prod MAPBOX_PUBLIC_TOKEN ADMIN_TOKEN POSTGRES_PASSWORD)

MAPBOX_PUBLIC_TOKEN=$(kamal secrets extract MAPBOX_PUBLIC_TOKEN $SECRETS)
ADMIN_TOKEN=$(kamal secrets extract ADMIN_TOKEN $SECRETS)
POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD $SECRETS)

# GitHub token of the logged-in gh account, used to push to ghcr.io.
KAMAL_REGISTRY_PASSWORD=$(gh auth token)

# Built from POSTGRES_PASSWORD so the password lives in one place.
# geotool-db is the Kamal accessory container on the kamal network.
DATABASE_URL=postgresql+psycopg://geotool:$POSTGRES_PASSWORD@geotool-db:5432/geotool
